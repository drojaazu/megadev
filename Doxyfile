# Doxyfile for MEGADEV
#
# Generate with: make docs   (or: doxygen Doxyfile)
# Output lands in docs/html, which is not tracked.

DOXYFILE_ENCODING = UTF-8

PROJECT_NAME      = MEGADEV
PROJECT_NUMBER    = 1.2.0
PROJECT_BRIEF     = "A Sega Mega Drive and Mega CD development kit"

OUTPUT_DIRECTORY  = docs
TAB_SIZE          = 2

USE_MDFILE_AS_MAINPAGE = README.md

GENERATE_LATEX    = NO
GENERATE_HTML     = YES
RECURSIVE         = YES
EXTRACT_STATIC    = YES

ENABLE_PREPROCESSING = YES
MACRO_EXPANSION      = YES
EXPAND_ONLY_PREDEF   = YES
PREDEFINED           = "TARGET=MEGACD"

# Prose documentation lives in docs/. RECURSIVE would also sweep in the
# generated HTML, hence the EXCLUDE.
INPUT             = README.md docs lib
EXCLUDE           = docs/html

# Assembly files are mapped to C so the documentation blocks in .s files are
# parsed. Doxygen reads the comment blocks and skips the mnemonics.
FILE_PATTERNS     = *.h *.s *.c *.md
EXTENSION_MAPPING = s=C

# Megadev-specific commands. Every custom command used in the source must be
# declared here, or it renders as literal text.
ALIASES += clobber="\warning REGISTER CLOBBERS: "
ALIASES += aliases="^^Aliases: \ref "
ALIASES += aliasof="^^Alias of \ref "

# The name Sega's documentation uses for a system call or vector that Megadev
# names descriptively; the Sega name is also kept as a #define synonym.
ALIASES += segaalias="^^**Sega documentation name:** "
