# Megadev dev container on Alpine Linux, a smaller alternative to
# new_project/Dockerfile: the kit, cloned into MEGADEV_PATH, and the Megadev
# toolchain, built from the same branch with tools/build-toolchain.sh (which
# takes a while the first time). The toolchain's bin directory is on PATH, so
# the kit's default M68K_PREFIX (m68k-elf-) finds it.
#
# The Alpine release is pinned, since package names such as clangNN-extra-tools
# change between releases.

ARG ALPINE_VERSION=3.24
ARG MEGADEV_REPO=https://github.com/drojaazu/megadev.git
ARG MEGADEV_BRANCH=master
ARG TOOLCHAIN_PATH=/opt/megadev-toolchain

FROM alpine:${ALPINE_VERSION} AS base
RUN \
	apk add --no-cache \
		bash \
		git \
		make \
		openssh \
		gmp \
		mpfr4 \
		mpc1 \
		clang22-extra-tools \
		xxd \
		cdrkit

FROM base AS toolchain

ARG MEGADEV_REPO
ARG MEGADEV_BRANCH
ARG TOOLCHAIN_PATH

RUN \
	apk add --no-cache \
		build-base \
		curl \
		xz \
		gmp-dev \
		mpfr-dev \
		mpc1-dev \
		&& \
	git clone --depth 1 --branch ${MEGADEV_BRANCH} ${MEGADEV_REPO} /tmp/megadev && \
	/tmp/megadev/tools/build-toolchain.sh ${TOOLCHAIN_PATH}

FROM base AS dev_container

ARG MEGADEV_REPO
ARG MEGADEV_BRANCH
ARG TOOLCHAIN_PATH
ARG MEGADEV_PATH=/opt/megadev

COPY --from=toolchain ${TOOLCHAIN_PATH} ${TOOLCHAIN_PATH}

RUN \
	adduser -D -s /bin/bash megadev && \
	git clone --branch ${MEGADEV_BRANCH} ${MEGADEV_REPO} ${MEGADEV_PATH} && \
	chown -R megadev:megadev ${MEGADEV_PATH} && \
	printf "    __  __________________    ____  _______    __\n   /  |/  / ____/ ____/   |  / __ \\/ ____/ |  / /\n  / /|_/ / __/ / / __/ /| | / / / / __/  | | / / \n / /  / / /___/ /_/ / ___ |/ /_/ / /___  | |/ /  \n/_/  /_/_____/\\____/_/  |_/_____/_____/  |___/   \n    Sega Mega Drive/Mega CD development kit\n" > /etc/motd \
		&& \
	echo "unset PROMPT_COMMAND" >> /home/megadev/.bashrc && \
	echo "PS1='\[\033[01;34m\]\w\[\033[00m\]# \[\]'" >> /home/megadev/.bashrc && \
	echo "cat /etc/motd" >> /home/megadev/.bashrc

USER megadev
WORKDIR /home/megadev

ENV PATH=${TOOLCHAIN_PATH}/bin:${PATH}
ENV MEGADEV_PATH=${MEGADEV_PATH}

CMD ["bash"]
